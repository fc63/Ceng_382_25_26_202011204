@page
@model LabProject.Pages.ClassManAppModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Class Management";
}

<style>
    th.exportable-column.table-active {
        background-color: #d1e7dd;
        font-weight: bold;
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="d-flex justify-content-end mb-2">
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="btn btn-sm btn-outline-dark">
                <i class="fa fa-sign-out me-1"></i> Logout
            </button>
        </form>
    </div>
    <div class="row">
        <div class="col-md-5">
            <h4>@(Model.IsEdit ? "Edit Class" : "Add Class")</h4>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.ClassName" class="form-label"></label>
                    <input asp-for="Input.ClassName" class="form-control" />
                    <span asp-validation-for="Input.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.StudentCount" class="form-label"></label>
                    <input asp-for="Input.StudentCount" class="form-control" />
                    <span asp-validation-for="Input.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
                @if (Model.IsEdit)
                {
                    <input type="hidden" asp-for="EditId" />
                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning">Update</button>
                    <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
                }
                else
                {
                    <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add</button>
                }
            </form>
        </div>

        <div class="col-md-7">
            <h4>Class List</h4>

            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="filter" value="@Model.Filter" class="form-control" placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-outline-secondary">Filter</button>
                </div>
            </form>

            <form method="post" asp-page-handler="ExportJson" id="exportForm">
                <input type="hidden" name="filtered" value="true" />
                <input type="hidden" name="filter" value="@Model.Filter" />
                <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                <button type="submit" class="btn btn-success">Export as JSON</button>
            </form>

            <table class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th class="exportable-column" data-column="ClassName">Class Name</th>
                        <th class="exportable-column" data-column="StudentCount">Student Count</th>
                        <th class="exportable-column" data-column="Description">Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DisplayedList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <a asp-page="/ClassManApp" asp-route-EditId="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&filter=@Model.Filter">Previous</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i&filter=@Model.Filter">@i</a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&filter=@Model.Filter">Next</a>
                </li>
            }
        </ul>
    </nav>
}

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectedColumns = new Set(['ClassName', 'StudentCount', 'Description']);
            const columnElements = document.querySelectorAll('.exportable-column');
            const form = document.getElementById('exportForm');

            columnElements.forEach(col => {
                col.style.cursor = 'pointer';
                col.addEventListener('click', () => {
                    const colName = col.dataset.column;
                    if (selectedColumns.has(colName)) {
                        selectedColumns.delete(colName);
                        col.classList.remove('table-active');
                    } else {
                        selectedColumns.add(colName);
                        col.classList.add('table-active');
                    }
                    updateHiddenInputs();
                });
            });

            function updateHiddenInputs() {
                const oldInputs = form.querySelectorAll('input[name="selectedColumns"]');
                oldInputs.forEach(i => i.remove());

                selectedColumns.forEach(col => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'selectedColumns';
                    input.value = col;
                    form.appendChild(input);
                });
            }

            updateHiddenInputs();
        });
    </script>
}