@page
@model ClassManApp.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Class Management";
}

@*

Week 7 Prompt:
"
"Take the following Razor Page view file (index.cshtml) and update it to add a JSON Export feature as described:
Requirements:

    Do not change anything in the backend logic (index.cshtml.cs). Only modify the Razor view (index.cshtml).

    Add a new POST form below the filter form and above the table. This form should:

        Submit to the page handler ExportJson.

        Include a hidden input named filtered with value true.

        Include a hidden input that retains the current filter value (@Model.Filter) for server use.

        Show four checkboxes named selectedColumns with values: Id, ClassName, StudentCount, and Description, all checked by default.

        Include a button that submits the form with the label “Export as JSON”.

    Ensure the layout and design is consistent with Bootstrap styling.

    Place the form above the table so that it logically applies to the data being displayed.

Keep the rest of the file (form for adding/editing classes, filter input, table, pagination, etc.) unchanged.

Return only the updated index.cshtml file."

Helpers/Utils.cs: "week7 utils.cs content will be located here"
"
*@

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="row">
        <div class="col-md-5">
            <h4>@(Model.IsEdit ? "Edit Class" : "Add Class")</h4>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.ClassName" class="form-label"></label>
                    <input asp-for="Input.ClassName" class="form-control" />
                    <span asp-validation-for="Input.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.StudentCount" class="form-label"></label>
                    <input asp-for="Input.StudentCount" class="form-control" />
                    <span asp-validation-for="Input.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
                @if (Model.IsEdit)
                {
                    <input type="hidden" asp-for="EditId" />
                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning">Update</button>
                    <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
                }
                else
                {
                    <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add</button>
                }
            </form>
        </div>

        <div class="col-md-7">
            <h4>Class List</h4>

            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="filter" value="@Model.Filter" class="form-control" placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-outline-secondary">Filter</button>
                </div>
            </form>

        <form method="post" asp-page-handler="ExportJson" class="mb-3">
            <input type="hidden" name="filtered" value="true" />
            <input type="hidden" name="filter" value="@Model.Filter" />
            <div class="mb-2">
                <label class="form-check-label fw-bold">Export Columns:</label><br />
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="selectedColumns" value="Id" checked />
                    <label class="form-check-label">Id</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="selectedColumns" value="ClassName" checked />
                    <label class="form-check-label">Class Name</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="selectedColumns" value="StudentCount" checked />
                    <label class="form-check-label">Student Count</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="selectedColumns" value="Description" checked />
                    <label class="form-check-label">Description</label>
                </div>
            </div>
            <button type="submit" class="btn btn-success">Export as JSON</button>
        </form>

            <table class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DisplayedList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <a asp-page="/Index" asp-route-EditId="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&filter=@Model.Filter">Previous</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i&filter=@Model.Filter">@i</a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&filter=@Model.Filter">Next</a>
                </li>
            }
        </ul>
    </nav>
}

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
