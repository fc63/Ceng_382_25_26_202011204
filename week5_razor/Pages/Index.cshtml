@page
@model week5_razor.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Class Management";
}
@*
Week 6 Prompt:
"
"Transform the given Index.cshtml Razor Page to meet the following updated specifications:

    Filtering and Pagination Support:

        Add a filter form at the top-right of the page that submits a GET request with a filter query parameter.

        Implement pagination below the table using Model.CurrentPage, Model.TotalPages, and page numbers.

        Pagination links should preserve the filter value.

    Table Display Updates:

        The table should exclude the Id column from being displayed.

        The DisplayedList property from the model should be used instead of ClassList.

        Each row should still provide Edit and Delete actions using item.Id behind the scenes.

    Styling and Layout:

        Use Bootstrap classes (via CDN) for responsive layout.

        Keep the form on the left and the class list table on the right, using Bootstrap grid.

    Model Integration:

        Use Razor Tag Helpers (asp-for, asp-route, asp-page-handler) to bind the form and actions properly.

    Form Behavior:

        If Model.IsEdit is true, show "Update" and "Cancel" buttons and prefill the form with the current class data.

        Otherwise, show only the "Add" button.

Replace the provided Razor code accordingly and preserve all existing form validation support.
Do not change logic outside the view layer."
Current index.cshtml: "this should contain the week5 index.cshtml code"
"
*@

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="row">
        <div class="col-md-5">
            <h4>@(Model.IsEdit ? "Edit Class" : "Add Class")</h4>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Input.ClassName" class="form-label"></label>
                    <input asp-for="Input.ClassName" class="form-control" />
                    <span asp-validation-for="Input.ClassName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.StudentCount" class="form-label"></label>
                    <input asp-for="Input.StudentCount" class="form-control" />
                    <span asp-validation-for="Input.StudentCount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
                @if (Model.IsEdit)
                {
                    <input type="hidden" asp-for="EditId" />
                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning">Update</button>
                    <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
                }
                else
                {
                    <button type="submit" asp-page-handler="Add" class="btn btn-primary">Add</button>
                }
            </form>
        </div>

        <div class="col-md-7">
            <h4>Class List</h4>

            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="filter" value="@Model.Filter" class="form-control" placeholder="Filter by class name" />
                    <button type="submit" class="btn btn-outline-secondary">Filter</button>
                </div>
            </form>

            <table class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DisplayedList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <a asp-page="/Index" asp-route-EditId="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage - 1)&filter=@Model.Filter">Previous</a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i&filter=@Model.Filter">@i</a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(Model.CurrentPage + 1)&filter=@Model.Filter">Next</a>
                </li>
            }
        </ul>
    </nav>
}

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
